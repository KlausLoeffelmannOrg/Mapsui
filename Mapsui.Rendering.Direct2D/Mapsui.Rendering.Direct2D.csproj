<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <Description>Direct2D and DirectComposition rendering for Mapsui.</Description>
    <PackageId>Mapsui.Rendering.Direct2D</PackageId>
    <PackageTags>$(PackageTags) rendering Direct2D DirectComposition</PackageTags>
    <IsPackable>true</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapsui\Mapsui.csproj" />
  </ItemGroup>

  <Import Project="..\Mapsui.Direct2D\Mapsui.Direct2D.props" />

</Project>
